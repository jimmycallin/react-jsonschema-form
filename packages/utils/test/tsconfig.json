{
  "extends": "../../../tsconfig.base.json",
  "include": ["./"],
  "compilerOptions": {
    "rootDir": "./",
    // Declarations only: packages/validator-*/test/utilsTests consume these helpers through a project
    // reference, but every test runs from source, so no JavaScript is needed here.
    "emitDeclarationOnly": true,
    "outDir": "../lib-test",
    // Vitest owns this module graph, so it is checked the way it runs.
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom/vitest"]
  },
  "references": [{ "path": ".." }]
}
